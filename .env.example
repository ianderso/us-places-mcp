# Copy to .env to change a default. Nothing here is required: every service
# is public and needs no key.
#
# The server reads .env from the directory it is started in. Variables already
# set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so the services
# can reach you if your use ever causes them trouble.
# US_PLACES_CONTACT=you@example.org

# Optional: directory for the on-disk response cache. Downloaded datasets (the
# US post offices, GNIS state files from 2021) go in its "data" folder.
# US_PLACES_CACHE_DIR=~/.cache/us-places-mcp

# Optional: HTTP timeout in seconds (default 60).
# US_PLACES_TIMEOUT=60

# Optional: service endpoints. Must be https.
# US_PLACES_OVERPASS_URL=https://overpass-api.openhistoricalmap.org/api/interpreter
# US_PLACES_PLSS_URL=https://gis.blm.gov/arcgis/rest/services/Cadastral/BLM_Natl_PLSS_CadNSDI/MapServer
# US_PLACES_GNIS_URL=https://carto.nationalmap.gov/arcgis/rest/services/geonames/MapServer
# US_PLACES_GNIS_ARCHIVE_URL=https://prd-tnm.s3.amazonaws.com/StagedProducts/GeographicNames/Archive/MainDomestic
# US_PLACES_TNM_URL=https://tnmaccess.nationalmap.gov/api/v1/products
# US_PLACES_DATAVERSE_URL=https://dataverse.harvard.edu
